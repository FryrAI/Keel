{
  "mcpServers": {
    "keel": {
      "command": "keel",
      "args": ["serve", "--mcp"]
    }
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "keel hook session-start"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "keel hook plan-check"
          }
        ]
      }
    ]
  }
}
