{
  "version": "0.6.0",
  "languages": [
    "python",
    "rust",
    "typescript"
  ],
  "enforce": {
    "type_hints": true,
    "docstrings": true,
    "placement": true,
    "progressive": true,
    "dead_code": true,
    "duplication": true,
    "oversized_files": true,
    "max_file_lines": 400
  },
  "circuit_breaker": {
    "max_failures": 3
  },
  "batch": {
    "timeout_seconds": 60
  },
  "ignore_patterns": [],
  "tier": "free",
  "telemetry": {
    "enabled": true,
    "remote": true,
    "endpoint": "https://keel.engineer/api/telemetry"
  },
  "monorepo": {
    "enabled": true,
    "kind": "CargoWorkspace",
    "packages": [
      "keel-core",
      "keel-parsers",
      "keel-enforce",
      "keel-cli",
      "keel-server",
      "keel-output"
    ]
  },
  "tier3": {
    "enabled": false,
    "scip_paths": {},
    "lsp_commands": {},
    "prefer_scip": true
  },
  "architecture": {
    "count_type_deps": false,
    "deny": []
  },
  "review": {
    "gate": []
  }
}